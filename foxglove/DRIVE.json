    "0b0eef3c-bd5c-4cf1-b1f5-86f51e1acdcf": {
      "sourceCode": "import { Input, Message } from \"./types\";\n\ntype PoseArray = Message<\"geometry_msgs/PoseArray\">;\n\nexport const inputs = [\"/pose\"];\nexport const output = \"/last_poses\";\n\nlet lastPoses: any[] = [];\nconst MAX_POSES = 50; // Change the value of x here\n\nexport default function script(msg: Input<\"/pose\">): PoseArray {\n  lastPoses.push(msg.message.pose);\n  if (lastPoses.length > MAX_POSES) {\n    lastPoses.shift();\n  }\n\n  return {\n    header: msg.message.header,\n    poses: lastPoses,\n  };\n}\n",
      "name": "pose_trail"
    }
  },
